# =================================
# CONTACT FORM (Cloudflare Pages Function -> Resend)
# =================================
# Set these in the Cloudflare Pages dashboard:
#   Settings -> Environment variables -> Production AND Preview
# They are read at request time by functions/api/send-email.ts.
# They are NOT baked into the build, so a local .env does not affect the deployed site.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_TO=you@example.com

# =================================
# NEXT_PUBLIC_ vars — build time only
# Must be present when `npm run build` runs, or they won't reach the client bundle.
# =================================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
